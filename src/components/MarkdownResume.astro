---
import type { ResumeSection } from "../lib/resumeSections";

const { sections } = Astro.props as { sections: ResumeSection[] };
const number = (index: number) => String(index + 1).padStart(2, "0");
---

{sections.map((section, index) => (
  <section class={`section grid section-${section.id}`} id={section.id} aria-labelledby={`${section.id}-title`}>
    <h2 class="section-title" id={`${section.id}-title`}>
      <span class="num">{number(index)}</span>{section.title}
    </h2>
    <div class="section-body">
      {section.entries ? (
        section.entries.map((entry) => (
          <article class="entry">
            <h3>{entry.company}</h3>
            <p class="entry-range">{entry.range}</p>
            <p class:list={["entry-role", { current: entry.current }]}>{entry.role}</p>
            <div class="prose" set:html={entry.html} />
          </article>
        ))
      ) : section.items ? (
        <dl class="contact-list">
          {section.items.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd set:html={item.html} />
            </div>
          ))}
        </dl>
      ) : (
        <div class="prose" set:html={section.html} />
      )}
    </div>
  </section>
))}
